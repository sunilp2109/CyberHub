generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  FACULTY
  HOD
  DEPARTMENT_ADMIN
  ADMIN
}

enum AchievementType {
  PROJECT
  INTERNSHIP
  CERTIFICATE
  COMPETITION
  PUBLICATION
  PATENT
  RESEARCH
  WORKSHOP
  CONFERENCE
  HACKATHON
  LEADERSHIP
  VOLUNTEERING
  AWARD
}

enum AchievementStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model User {
  id           String    @id @default(uuid())
  identifier   String    @unique
  email        String?   @unique
  phone        String?
  name         String
  passwordHash String
  role         UserRole
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  student      Student?
  staffProfile StaffProfile?
  achievements Achievement[] @relation("AchievementSubmitter")
  reviews      ApprovalAction[]
  facultyEvents FacultyEvent[]

  @@index([role])
  @@index([active])
  @@index([departmentId])
}

model FacultyEvent {
  id          String   @id @default(uuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  mode        String
  name        String
  category    String
  eventDate   DateTime @db.Date
  facultyRole String
  details     Json
  createdAt   DateTime @default(now())

  @@index([ownerId, eventDate])
}

model Department {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String    @unique
  active    Boolean   @default(true)
  users     User[]
  students  Student[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Student {
  id           String        @id @default(uuid())
  userId       String        @unique
  registerNo   String        @unique
  department   String
  departmentId String?
  programme    String
  batch        String
  semester     Int
  academicYear String?
  yearOfStudy  Int?
  classSection String?
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentRef Department?   @relation(fields: [departmentId], references: [id])
  achievements Achievement[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model StaffProfile {
  id           String     @id @default(uuid())
  userId       String     @unique
  employeeId   String     @unique
  designation  String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Achievement {
  id           String             @id @default(uuid())
  studentId    String
  submittedBy  String
  type         AchievementType
  title        String
  description  String?
  metadata     Json?
  status       AchievementStatus  @default(DRAFT)
  submittedAt  DateTime?
  academicYear String?
  yearOfStudy  Int?
  reviewedAt   DateTime?
  student      Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submitter    User               @relation("AchievementSubmitter", fields: [submittedBy], references: [id])
  documents    AchievementDocument[]
  approvals    ApprovalAction[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([studentId, status])
  @@index([status, createdAt])
}

model AchievementDocument {
  id            String      @id @default(uuid())
  achievementId String
  fileName      String
  storageKey    String
  mimeType      String
  sizeBytes     Int
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
}

model ApprovalAction {
  id            String      @id @default(uuid())
  achievementId String
  reviewerId    String
  action        AchievementStatus
  comment       String?
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  reviewer      User        @relation(fields: [reviewerId], references: [id])
  createdAt     DateTime    @default(now())

  @@index([achievementId, createdAt])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
